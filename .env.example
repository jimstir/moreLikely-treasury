# -----------------------------------------------------------------------------
# moreLikely Smart Treasury - Environment Variables
# -----------------------------------------------------------------------------

# Uniswap Swapping API Key (for retrieving live trade quotes and router calldata)
UNISWAP_API_KEY=""

# Live Sepolia Network Signer Private Keys (must hold Sepolia ETH / testnet tokens)
OWNER_PRIVATE_KEY=""
STAKEHOLDER_PRIVATE_KEY=""
# Circle Developer-Controlled Wallets Configuration (Agent Execution)
CIRCLE_API_KEY=""
CIRCLE_ENTITY_SECRET=""
CIRCLE_WALLET_ID=""

# Sepolia Network RPC URL (for local network forking and testnet queries)
SEPOLIA_RPC_URL="https://gateway.tenderly.co/public/sepolia"

# 0G Compute Network API key (obtained from 0g-compute-cli get-secret, e.g. app-sk-<SECRET>)
ZEROG_COMPUTE_API_KEY=""

# 0G Compute Network Base URL (e.g. https://compute-network-19.integratenetwork.work/v1/proxy)
ZEROG_COMPUTE_BASE_URL="https://compute-network-19.integratenetwork.work/v1/proxy"

# -----------------------------------------------------------------------------
# Frontend Application Environment Variables (put these in frontend/.env)
# -----------------------------------------------------------------------------

# PostgreSQL database connection string for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_treasury?schema=public"

# The chosen treasury deployment chain: "testnet" (Sepolia) or "mainnet" (Ethereum)
# Defaults to "testnet" if omitted.
NEXT_PUBLIC_DEPLOY_NETWORK="testnet"

# -----------------------------------------------------------------------------
# Layer 2 AI Contextual Overlay & Subscriptions
# -----------------------------------------------------------------------------

# Address of the SubscriptionManager contract for verifying auto-renew status
NEXT_PUBLIC_SUBSCRIPTION_CONTRACT="0xYourSubscriptionManagerAddress"

# -----------------------------------------------------------------------------
# AI Governor Deployment Configurations
# -----------------------------------------------------------------------------

# Option 1: Platform Subscriber (Google Gemini)
# Platform handles billing via the SubscriptionManager. Just provide the API endpoint if running locally.
GEMINI_API_KEY=""

# Universal Backend Allowances for Subscribers
# These variables define the universal constraints enforced by the backend Orchestrator for all active subscribers.
PLATFORM_MONTHLY_INFERENCE_ALLOWANCE=1000
PLATFORM_MAX_TOKENS_PER_REQUEST=4096

# Option 2: Private / Self-Hosted Provider
# If you selected "Private/Self-Hosted", provide your own inference endpoint (e.g., local vLLM, OpenAI)
PRIVATE_LLM_BASE_URL="https://api.openai.com/v1"
PRIVATE_LLM_API_KEY="your_private_api_key_here"

# Oracle Router Address
NEXT_PUBLIC_ORACLE_ROUTER_ADDRESS=""

# -----------------------------------------------------------------------------
# Treasury Document Storage (Mandates & Prompts)
# -----------------------------------------------------------------------------
# Supported values: "MODE_A_STANDARD" or "MODE_B_0G"
STORAGE_MODE="MODE_A_STANDARD"

# Standard Storage Config (Supports AWS S3, Google Cloud, Cloudflare R2, etc.)
# Most modern cloud providers support the S3-compatible API.
STORAGE_ACCESS_KEY="your_storage_access_key"
STORAGE_SECRET_KEY="your_storage_secret_key"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET_NAME="morelikely-treasury-prompts"
STORAGE_ENDPOINT_URL="" # e.g., https://storage.googleapis.com (if using Google Cloud)

# 0G Decentralized Storage Config
ZEROG_STORAGE_RPC="https://rpc.0g.ai"
ZEROG_STORAGE_NODE_URL="https://storage.0g.ai"
